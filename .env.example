# ---------------------------------------------------------------------------
# Foundry Tax Automation -- configuration template
#
# Copy to `.env` and fill in your own values. `.env` is gitignored.
# NEVER commit keys, tokens or SAS URLs. See docs/configuration.md for the
# full reference and docs/deployment.md for how to set these on Azure.
# ---------------------------------------------------------------------------

# === Shared: Microsoft Foundry project ======================================
# Format: https://<account>.services.ai.azure.com/api/projects/<project-name>
FOUNDRY_PROJECT_ENDPOINT="https://<your-account>.services.ai.azure.com/api/projects/<your-project>"
AZURE_AI_MODEL_DEPLOYMENT_NAME="gpt-4.1-mini"

# === extraction-agent (Document Intelligence) ===============================
# Prefer a Key Vault reference + managed identity in production.
DOCUMENTINTELLIGENCE_ENDPOINT="https://<your-doc-intel>.cognitiveservices.azure.com/"
DOCUMENTINTELLIGENCE_API_KEY=""

# === sow-builder-agent (Azure AI Search) ====================================
# Leave empty to use clearly-labelled demo data for local development.
AZURE_SEARCH_ENDPOINT="https://<your-search>.search.windows.net"
AZURE_SEARCH_KEY=""
AZURE_SEARCH_INDEX_NAME="prior-year-sows"

# === Client apps: app/streamlit_app.py and app/orchestrator.py ==============
# Full Responses-protocol endpoint URLs of the two DEPLOYED agents.
EXTRACTION_AGENT_ENDPOINT="https://<your-account>.services.ai.azure.com/api/projects/<your-project>/agents/extraction-agent/endpoint/protocols/openai/responses?api-version=v1"
SOW_AGENT_ENDPOINT="https://<your-account>.services.ai.azure.com/api/projects/<your-project>/agents/sow-builder-agent/endpoint/protocols/openai/responses?api-version=v1"

# Optional: override the bundled tax-computation prompt (app/tax_agent.md).
# TAX_AGENT_PROMPT_PATH="./app/tax_agent.md"

# Allow the Streamlit UI to fall back to demo SOW data if agent JSON parsing
# fails. Set to "false" to fail loudly instead (recommended for real usage).
DEMO_FALLBACK="true"

# Authentication uses DefaultAzureCredential (`az login` locally, managed
# identity on Azure). No access tokens belong in this file.
